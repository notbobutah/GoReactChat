# Backend configuration. Export these (direnv, your process manager, or
# `env $(cat .env | xargs)`) — the server deliberately does not read .env files,
# so there is exactly one place configuration can come from in production.

# --- server ---
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# --- auth ---
# dev: the bearer token IS the user id. Local only.
AUTH_MODE=dev
DEFAULT_WORKSPACE_ID=local-workspace

# --- persistence ---
# postgres | memory
STORE=postgres
DATABASE_URL=postgres://lumi:lumi@localhost:5433/lumi?sslmode=disable

# --- model ---
# anthropic | echo   (echo streams a canned reply; no API key needed)
MODEL_CLIENT=anthropic
ANTHROPIC_API_KEY=
STRONG_MODEL=claude-opus-5
FAST_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max — thinking depth and overall token spend
EFFORT=medium

# --- grounding documents ---
# Résumé + job description. Loaded at boot; drop a file in and restart.
# Relative to the server/ working directory when run via `make dev-*`.
DATA_DIR=../data

# A README describing work the candidate delivered, indexed alongside their
# documents as citable evidence. Empty or missing → skipped.
PROJECT_DOC=../README.md

# --- retrieval (RAG) ---
# on: chunk + embed the documents locally and expose them to the model through
#     a search tool.
# off: inline the full documents in the system prompt instead.
# Falls back to inlining automatically when Ollama is unreachable.
RAG=on
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_CACHE_DIR=../data/.embeddings

# --- limits ---
# Requests per window, per caller (user × workspace × tier).
RATE_LIMIT=6
# Requests per window across ALL callers. With one or two readers this is the
# limit that actually binds.
GLOBAL_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# Total tokens this deployment may ever spend, input + output, across every
# conversation. Persisted in Postgres, so a restart resumes the meter rather
# than resetting it. 0 disables the cap.
#
# Rough sizing at Claude Opus 5 rates ($5/M input, $25/M output): a turn here
# costs ~6-10k tokens, so 2,000,000 is roughly 200-300 turns and well under $20.
TOKEN_BUDGET=2000000

# --- Grok (xAI) ---
# Not read by the server yet — carried here so the credential is in one place
# when an xAI StreamingClient lands. The real key lives in .env (gitignored);
# the dev value comes from
# infrastructure/kubernetes/config/next-expona-secrets.dev.yaml.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai
GROK_BASE_URL_FULL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-imagine-image
