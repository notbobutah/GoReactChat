# Loaded by `next dev` only — `next build` never reads this file, so it cannot
# leak a localhost URL into a production image.
#
# Locally the Next dev server and the Go service are two processes on two ports,
# so the browser needs an absolute base URL. Deployed, one ingress host serves
# both and chat-client.ts falls back to a same-origin (relative) base.
NEXT_PUBLIC_LUMI_URL=http://localhost:8080
